rules_version = '2';

// 수어 시뮬레이션 사전 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여 넣고 "게시"를 누른다.
//
// 로그인한 사람은 자기 기록(users/{자기 uid}) 하나만 읽고 쓸 수 있다. 다른 사람의 기록은 볼 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progressJson', 'updatedAt', 'app'])
        && request.resource.data.progressJson is string
        && request.resource.data.progressJson.size() < 500000;
    }
  }
}
